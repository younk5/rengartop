rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'vinicios.felipe93@gmail.com',
        'marlon.moreno@gmail.com'
      ];
    }

    match /matchups/{matchupId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /guideContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /profileContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /clips/{clipId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
